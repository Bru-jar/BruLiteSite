# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# --- Discord OAuth ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Discord Bot (see docs/discord-setup.md) ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CUSTOMER_ROLE_ID=
DISCORD_ADMIN_ROLE_IDS= # comma-separated role IDs
# Tickets → Discord. Preferred: forum channel(s) (each ticket = a thread).
DISCORD_TICKETS_FORUM_ID=         # shared forum, or use the per-type ones
DISCORD_TICKETS_FORUM_BUG=
DISCORD_TICKETS_FORUM_FEATURE=
DISCORD_TICKETS_TAG_BUG=          # optional forum tag IDs
DISCORD_TICKETS_TAG_FEATURE=
# Fallback: plain channel webhook (used when no forum ID is set)
DISCORD_TICKETS_WEBHOOK_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Vercel Blob (client download hosting) ---
BLOB_READ_WRITE_TOKEN=

# --- Terms version; bump to re-prompt acceptance ---
TERMS_VERSION=1

# --- Oldest BruLite client version still entitled (empty = no floor) ---
MIN_CLIENT_VERSION=

# Auth maintenance: random 32+ character secret; schedule the protected cleanup route hourly.
CRON_SECRET=
